            "description": {
              "content": "Performs complex signup process at once, including registering dummy payment method. Specify `email` and `password` for an operator which will be created on sandbox, `authKeyId` and `authKey` for a real operator on the production environment. An API Key and an API Token will be included in the response if successful. Use the API Key and the API Token to requests afterwards.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sandbox",
                "init"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
