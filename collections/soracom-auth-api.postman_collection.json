        {
          "id": "45fa4433-3b18-4cf2-94e1-ee61c6df6f36",
          "name": "Revokes an API key and API token in order to remove access to the Soracom API.",
          "request": {
            "name": "Revokes an API key and API token in order to remove access to the Soracom API.",
            "description": {
              "content": "Revokes the API key and API token that was used to call this API. Once revoked, the API key and API token cannot be used to make further requests to the API, regardless of the key and token's original expiration time. This API can be called regardless of any permission settings.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "auth",
                "logout"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Soracom-API-Key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
          "response": [
            {
              "id": "0a58c14d-b078-456b-9fb9-189bb24ebca7",
              "name": "Successfully revoked the API key and the API token.",
              "originalRequest": {
                "url": {
                  "path": [
                    "auth",
                    "logout"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: apikey",
                      "type": "text/plain"
                    },
                    "key": "X-Soracom-API-Key",
                    "value": "<API Key>"
                  }
                ],
                "method": "POST",
                "body": {}
              },
              "status": "No Content",
              "code": 204,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "text/plain"
                }
              ],
              "body": "",
              "cookie": [],
              "_postman_previewlanguage": "text"
            }
          ],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
