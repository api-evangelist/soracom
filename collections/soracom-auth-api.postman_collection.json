      "item": [
        {
          "id": "4ac8bb99-6eb8-4f6b-9ddc-763c6cdf2fb9",
          "name": "Performs authentication to access to the Soracom API.",
          "request": {
            "name": "Performs authentication to access to the Soracom API.",
            "description": {
              "content": "Performs authentication to access to the Soracom API. Please include the following information in your request.\n\n- To perform authentication by a root account, specify `email` and `password`.\n- To perform authentication by an AuthKey, specify `authKeyId` and `authKey`.\n- To perform authentication by a SAM user, specify `operatorId`, `userName` and `password`.\n\nAn API key and API token will be included in the response if successful. Use the API key and API token to perform subsequent requests.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "auth"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"authKey\": \"<string>\",\n  \"authKeyId\": \"<string>\",\n  \"email\": \"<string>\",\n  \"mfaOTPCode\": \"<string>\",\n  \"operatorId\": \"<string>\",\n  \"password\": \"<string>\",\n  \"tokenTimeoutSeconds\": 86400,\n  \"userName\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "c50e8a72-eae4-4708-a223-cb4d82e04e27",
              "name": "Authentication successful.",
              "originalRequest": {
                "url": {
