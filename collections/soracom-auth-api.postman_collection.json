        {
          "id": "103221c0-5e0b-4f33-b189-326503c0b8f8",
          "name": "Generates an API key and an API token to call APIs as a different user.",
          "request": {
            "name": "Generates an API key and an API token to call APIs as a different user.",
            "description": {
              "content": "Using the API key and API token of the original user, call this API to issue an API key and API token of the target user that you are switching to. The original user should already be registered in the target user's trust policy. See [User:updateUserTrustPolicy](#!/User/updateUserTrustPolicy) for information on updating the trust policy.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "auth",
                "switch_user"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Soracom-API-Key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
