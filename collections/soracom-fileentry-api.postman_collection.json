        {
          "id": "9a17503e-f13a-40b0-bfb6-ef60ebca4a7c",
          "name": "Find files with prefix query parameter in the scope",
          "request": {
            "name": "Find files with prefix query parameter in the scope",
            "description": {
              "content": "Returns a list of file entries which beginnings of their file paths are matched with the `prefix` query string in the ascending sorted UTF-8 bytes order of their file paths. An empty list is returned if the prefix does not match with any paths of file entries.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "files"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "scope",
                  "value": "<string>",
                  "description": "(Required) Scope of the request. Specify `private` to handle files uploaded to Harvest Files."
                },
                {
                  "disabled": false,
                  "key": "prefix",
                  "value": "<string>",
                  "description": "(Required) Prefix to match with file path."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "10",
                  "description": "Maximum number of file entries to be returned."
                },
                {
                  "disabled": false,
                  "key": "last_evaluated_key",
                  "value": "<string>",
                  "description": "The filePath of the last file entry retrieved on the previous page. By specifying this parameter, you can continue to retrieve the list from the next file entry onward."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Soracom-API-Key"
                },
                {
