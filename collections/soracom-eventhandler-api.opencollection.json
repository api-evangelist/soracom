        {
          "info": {
            "name": "Delete Event Handler",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.soracom.io/v1/event_handlers/:handler_id",
            "params": [
              {
                "name": "handler_id",
                "value": "",
                "type": "path",
                "description": "Event handler ID."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-Soracom-API-Key",
              "value": "{{X-Soracom-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Deletes the specified event handler."
        },
        {
          "info": {
            "name": "Ignore Event Handler",
            "type": "http"
