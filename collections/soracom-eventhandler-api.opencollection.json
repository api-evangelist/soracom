            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.soracom.io/v1/event_handlers/subscribers/:imsi",
            "params": [
              {
                "name": "imsi",
                "value": "",
                "type": "path",
                "description": "IMSI."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-Soracom-API-Key",
              "value": "{{X-Soracom-API-Key}}",
