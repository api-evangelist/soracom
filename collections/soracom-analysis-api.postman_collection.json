          "name": "Execute a new SQL query asynchronously",
          "request": {
            "name": "Execute a new SQL query asynchronously",
            "description": {
              "content": "Executes a SQL query asynchronously. You can check the status of a SQL query execution with the [Analysis:getAnalysisQueries API](#/Analysis/getAnalysisQueries).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "analysis",
                "queries"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Soracom-API-Key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
