        {
          "id": "1365c045-75fa-42bd-879c-57b295729c3a",
          "name": "Retrieve available database schemas",
          "request": {
            "name": "Retrieve available database schemas",
            "description": {
              "content": "Retrieves the available schemas and their column information within the database. You can use this information as a reference when converting data types of data retrieved with the [Analysis:startAnalysisQueries API](#/Analysis/startAnalysisQueries).\nExample: If the column `type` is `string` as shown below, it can be treated as a string.\n```json\n{\n  \"name\": \"SIM_SESSION_EVENTS\",\n  \"columnInfo\": [\n      {\n          \"name\": \"APN\",\n          \"type\": \"string\",\n          \"databaseType\": \"TEXT\",\n          \"description\": \"Access Point Name indicating the network gateway for the SIM session.\"\n      }\n  ]\n}\n```\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "analysis",
                "schemas"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Soracom-API-Key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
          "response": [
            {
              "id": "e2d7cc6c-4cec-4a87-b3bc-8d7a3a2f974e",
              "name": "A list of available database schemas and their column information.",
              "originalRequest": {
                "url": {
                  "path": [
                    "analysis",
                    "schemas"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: apikey",
                      "type": "text/plain"
                    },
                    "key": "X-Soracom-API-Key",
                    "value": "<API Key>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "[\n  {\n    \"columnInfo\": [\n      {\n        \"databaseType\": \"TEXT\",\n        \"description\": \"Access Point Name indicating the network gateway for the SIM session.\",\n        \"name\": \"APN\",\n        \"type\": \"string\"\n      },\n      {\n        \"databaseType\": \"TEXT\",\n        \"description\": \"The primary DNS server IP address used during the SIM session.\",\n        \"name\": \"DNS0\",\n        \"type\": \"string\"\n      },\n      {\n        \"databaseType\": \"TEXT\",\n        \"description\": \"The secondary DNS server IP address used during the SIM session.\",\n        \"name\": \"DNS1\",\n        \"type\": \"string\"\n      },\n      {\n        \"databaseType\": \"TEXT\",\n        \"description\": \"Describes the type of event associated with the SIM session, such as Created, Deleted, or Updated.\",\n        \"name\": \"EVENT\",\n        \"type\": \"string\"\n      },\n      {\n        \"databaseType\": \"TEXT\",\n        \"description\": \"Home Public Land Mobile Network code that identifies the home network operator.\",\n        \"name\": \"HPLMN\",\n        \"type\": \"string\"\n      },\n      {\n        \"databaseType\": \"TEXT\",\n        \"description\": \"The Integrated Circuit Card Identifier, a unique number assigned to the SIM card.\",\n        \"name\": \"ICCID\",\n        \"type\": \"string\"\n      }\n    ],\n    \"name\": \"SIM_SESSION_EVENTS\"\n  }\n]",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
