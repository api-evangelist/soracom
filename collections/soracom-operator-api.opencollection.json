              "placement": "header"
            }
          },
          "docs": "Revokes operator's MFA without backup codes."
        },
        {
          "info": {
            "name": "Verify Operator's MFA OTP Code",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.soracom.io/v1/operators/:operator_id/mfa/verify",
            "params": [
              {
                "name": "operator_id",
                "value": "",
                "type": "path",
