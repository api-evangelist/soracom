        },
        {
          "info": {
            "name": "Revoke all API keys and API tokens that were generated by the root user",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.soracom.io/v1/operators/:operator_id/tokens",
            "params": [
              {
                "name": "operator_id",
                "value": "",
                "type": "path",
