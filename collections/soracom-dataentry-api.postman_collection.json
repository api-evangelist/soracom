          "id": "b264dd81-99c4-4f55-bc00-512202f28114",
          "name": "Get data sent to Harvest Data from a resource.",
          "request": {
            "name": "Get data sent to Harvest Data from a resource.",
            "description": {
              "content": "Returns a list of data entries sent to Harvest Data from a device that match certain criteria. If the total number of entries does not fit in one page, a URL for accessing the next page is returned in the `link` header of the response.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "data",
                ":resource_type",
                ":resource_id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<integer>",
                  "description": "Start time for the data entries search range (UNIX time in milliseconds)."
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<integer>",
                  "description": "End time for the data entries search range (UNIX time in milliseconds)."
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "desc",
                  "description": "Sort order of the data entries. Either descending (latest data entry first) or ascending (oldest data entry first)."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Maximum number of data entries to retrieve (value range is 1 to 1000). The default is `10`."
                },
                {
                  "disabled": false,
                  "key": "last_evaluated_key",
                  "value": "<string>",
                  "description": "The value of the `x-soracom-next-key` header from the previous response. Specify this to retrieve the next page."
